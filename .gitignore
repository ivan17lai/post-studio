# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/
/web/hdr/poststudio_hdr.mjs
/web/hdr/poststudio_hdr.wasm
/work/toolchains/
/android/app/.cxx/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Built/distributed APKs — ship via GitHub Releases / NAS, never commit binaries
*.apk

# Screenshots and files attached to remote coding sessions. They land in the
# working tree automatically, and they are the sort of thing that carries an API
# key in an error message — keep them out of version control entirely.
.codex-remote-attachments/
